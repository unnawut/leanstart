# leanstart GKE sweep config — copy to `.env` and edit. The scripts in
# scripts/cloud/ auto-load this (repo-root .env, or $LEANSTART_ENV, or ./.env).
# `.env` is gitignored; never commit your real credentials path/keys.

# Path to the GCP service-account key JSON. A relative path is resolved against
# this .env file's directory, so `./gcp-credentials.json` means repo-root.
# With this set, you can omit --credentials on every script.
GKE_CREDENTIALS=./gcp-credentials.json

# GCP project. Defaults to project_id read from the key JSON if unset.
# GKE_PROJECT=my-project-id

# Zone + node tiers (defaults shown; uncomment to override).
# GKE_ZONE=us-central1-a
# GKE_LEAF_MACHINE=c4-standard-16
# GKE_AGG_MACHINE=c4-standard-32
# GKE_WORKERS_MACHINE=c4-standard-8

# Cluster name for sweeps.
# GKE_CLUSTER=leanstart-sweep
